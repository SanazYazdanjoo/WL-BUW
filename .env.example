# Server-only settings. Copy to .env.local and restart the server.
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT_FOLDER=/Welcome.Lounge_WiSe2026_27/S.Y

# Pilot staff authentication: disabled until strong, distinct codes are configured.
# Generate random codes >=20 characters and a session secret >=32 characters.
STAFF_PILOT_ENABLED=false
STAFF_ACCESS_CODE=
STAFF_ADMIN_CODE=
STAFF_SESSION_SECRET=
STAFF_DATA_DIR=staff-data
CONTENT_SOURCE_DIR=content-source
CONTENT_BACKUP_DIR=content-backups
# Optional internal refresh endpoint. Disabled unless explicitly enabled
# with a random server-only secret of at least 32 characters.
OFFICIAL_SOURCE_SYNC_ENABLED=false
OFFICIAL_SOURCE_SYNC_SECRET=
# Optional overrides; always relative to NEXTCLOUD_ROOT_FOLDER.
# STAFF_MASTER_WORKBOOK=staff-data/MasterExcel.xlsx
# CONTENT_SOURCE_WORKBOOK=content-source/Welcome Lounge First Steps and some other informations.xlsx
