{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/content/:kind",
      "destination": "/api/content?__api_path=content/:kind"
    },
    {
      "source": "/api/staff/:path*",
      "destination": "/api/staff?__api_path=staff/:path*"
    },
    {
      "source": "/api/nextcloud/:path*",
      "destination": "/api/nextcloud?__api_path=nextcloud/:path*"
    },
    { "source": "/((?!api(?:/|$)|assets/).*)", "destination": "/index.html" }
  ],
  "functions": { "api/**/*.js": { "maxDuration": 60 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
